{
  "manifest_version": 3,
  "name": "QuickCoop Hello World",
  "version": "0.1.0",
  "description": "Extensión local de prueba para QuickCoop.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickCoop"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.epicgames.com/*"
  ]
}
